{
  "expo": {
    "name": "QQIVA Business",
    "slug": "qqiva-business-offline",
    "version": "0.3.1",
    "orientation": "portrait",
    "scheme": "qqiva",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép QQIVA dùng camera để quét QR và chụp ảnh hồ sơ."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép QQIVA chọn ảnh sản phẩm, công trình và chứng từ."
        }
      ],
      "expo-sqlite",
      ["expo-media-library", { "granularPermissions": ["photo"] }]
    ],
    "android": {
      "package": "vn.qqiva.business",
      "versionCode": 4,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
